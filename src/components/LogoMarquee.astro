---
/**
 * Scrolling brand-logo strip. Logos normalized to one tone for a clean wall.
 */
const logos = [
  { src: '/img/logos/dove.png', name: 'Dove' },
  { src: '/img/logos/fenty.png', name: 'Fenty' },
  { src: '/img/logos/acc.png', name: 'ACC' },
  { src: '/img/logos/aeropostale.png', name: 'Aeropostale' },
  { src: '/img/logos/cheetos.png', name: 'Cheetos' },
  { src: '/img/logos/shein.png', name: 'SHEIN' },
  { src: '/img/logos/canes.svg', name: "Raising Cane's" },
];
// First set carries the brand name as alt; the duplicate set (for the seamless
// scroll) is decorative, so it's aria-hidden with empty alt.
const loop = [...logos, ...logos.map((l) => ({ ...l, dup: true }))];
---

<div class="logo-marquee">
  <div class="logo-track">
    {loop.map((l) => (
      <span class="logo-item">
        <img src={l.src} alt={l.dup ? '' : l.name} aria-hidden={l.dup ? 'true' : undefined} loading="eager" decoding="async" />
      </span>
    ))}
  </div>
</div>

<style>
  .logo-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .logo-track { display: flex; width: max-content; align-items: center; gap: clamp(3.5rem, 2.5rem + 3vw, 5.5rem); animation: logoscroll 50s linear infinite; }
  .logo-marquee:hover .logo-track { animation-play-state: paused; }
  .logo-item { flex: none; display: flex; align-items: center; }
  /* Full-colour, larger, readable — real brand proof, not gray blobs */
  .logo-item img { height: 60px; width: auto; opacity: 0.95; transition: opacity 0.3s var(--ease); }
  .logo-item img[src*="dove"] { height: 76px; }
  .logo-item img:hover { opacity: 1; }
  @keyframes logoscroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .logo-track { animation: none; } }
  @media (max-width: 560px) {
    .logo-item img { height: 42px; }
    .logo-item img[src*="dove"] { height: 54px; }
  }
</style>
